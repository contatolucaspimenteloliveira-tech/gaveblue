            </div>
            <div id="report-orders-card" class="filter-card p-6">
              <h3 id="report-orders-title" class="text-lg font-extrabold text-slate-900 mb-4">OS por veÃ­culo</h3>
              <div id="report-orders-table" class="space-y-3 text-sm text-slate-600"></div>
            </div>
          </div>
        </section>
      </div>
    </main>

  </div>

  <div id="toast-stack" class="toast-stack"></div>

  <div id="settings-overlay" class="panel-overlay" onclick="toggleSettings(false)"></div>
  <aside id="settings-panel" class="panel-shell" aria-hidden="true">
    <div class="panel-head">
      <div>
        <p class="panel-kicker">WeFrotas</p>
        <h2 class="panel-title">Configuraes</h2>
      </div>
      <button class="icon-action bg-white border border-slate-200 text-slate-600" type="button" onclick="toggleSettings(false)" aria-label="Fechar configuraÃ§Ãµes">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 6l12 12M18 6L6 18"/>
        </svg>
      </button>
    </div>
    <div class="panel-body">
      <div id="settings-screen-home" class="settings-screen active">
        <div class="settings-menu-list">
          <button type="button" class="settings-menu-item" onclick="openSettingsScreen('visual')">
            <div>
              <p class="settings-menu-title">Visual</p>
              <p class="settings-menu-subtitle">Tema e aparncia do sistema</p>
            </div>
            <span class="settings-menu-arrow"></span>
          </button>
          <button type="button" class="settings-menu-item" onclick="openSettingsScreen('brand')">
            <div>
              <p class="settings-menu-title">Marca</p>
              <p class="settings-menu-subtitle">Logo personalizada e tamanho</p>
            </div>
            <span class="settings-menu-arrow"></span>
          </button>
          <button type="button" class="settings-menu-item" onclick="openSettingsScreen('backup')">
            <div>
              <p class="settings-menu-title">Backup</p>
              <p class="settings-menu-subtitle">Exportao e restaurao local</p>
            </div>
            <span class="settings-menu-arrow"></span>
          </button>
          <button type="button" class="settings-menu-item" onclick="openSettingsScreen('import')">
            <div>
              <p class="settings-menu-title">ImportaÃ§Ã£o</p>
              <p class="settings-menu-subtitle">Planilha de veÃ­culos e modelos</p>
            </div>
            <span class="settings-menu-arrow"></span>
          </button>
          <button type="button" class="settings-menu-item" onclick="openSettingsScreen('about')">
            <div>
              <p class="settings-menu-title">Sobre os dados</p>
              <p class="settings-menu-subtitle">Como o WeFrotas salva informaes</p>
            </div>
            <span class="settings-menu-arrow"></span>
          </button>
        </div>
      </div>

      <div id="settings-screen-visual" class="settings-screen">
        <div class="settings-subhead">
          <button type="button" class="settings-back-btn" onclick="openSettingsScreen('home')"> Voltar</button>
          <h3 class="settings-subtitle-title">Visual</h3>
        </div>
        <section class="settings-block">
          <p class="settings-label">Tema</p>
          <div class="settings-grid">
            <button type="button" id="settings-theme-light" class="settings-action-btn" onclick="applyThemeState(false)">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="4" stroke-width="2"></circle>
                <path stroke-linecap="round" stroke-width="2" d="M12 2v2m0 16v2m10-10h-2M4 12H2m17.07-7.07l-1.41 1.41M6.34 17.66l-1.41 1.41m0-14.14l1.41 1.41m11.32 11.32l1.41 1.41"/>
              </svg>
              Claro
            </button>
            <button type="button" id="settings-theme-dark" class="settings-action-btn" onclick="applyThemeState(true)">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 15.5A7.5 7.5 0 1112.5 4 6 6 0 0020 15.5z"/>
              </svg>
              Escuro
            </button>
          </div>
        </section>
      </div>

      <div id="settings-screen-brand" class="settings-screen">
        <div class="settings-subhead">
          <button type="button" class="settings-back-btn" onclick="openSettingsScreen('home')"> Voltar</button>
          <h3 class="settings-subtitle-title">Marca</h3>
        </div>
        <section class="settings-block">
          <p class="settings-label">Logo personalizada</p>
          <div class="settings-list">
            <button type="button" id="settings-custom-logo-toggle" class="settings-action-btn full" onclick="toggleCustomLogoEnabled()">
              Ativar logo personalizada
            </button>
            <div class="settings-field-stack">
              <label class="settings-input-label" for="settings-custom-logo-file">Arquivo da logo</label>
              <input type="file" id="settings-custom-logo-file" class="settings-text-input" accept="image/png,image/jpeg,image/webp,image/svg+xml">
            </div>
            <div class="settings-logo-preview-shell">
              <img id="settings-custom-logo-preview" class="settings-logo-preview" src="" alt="Prvia da logo personalizada" hidden>
              <p id="settings-custom-logo-hint" class="settings-description !mb-0">Envie uma imagem do seu computador. Se a chave estiver desligada, o sistema continua usando a logo padro.</p>
            </div>
            <div class="settings-field-stack">
              <label class="settings-input-label" for="settings-custom-logo-size">Tamanho da logo</label>
              <input type="range" id="settings-custom-logo-size" min="15" max="220" step="5" value="60">
              <p id="settings-custom-logo-size-label" class="settings-description !mb-0">60%</p>
            </div>
            <button type="button" class="settings-action-btn full" onclick="saveCustomLogoSettings()">Salvar logo personalizada</button>
          </div>
        </section>
      </div>

      <div id="settings-screen-backup" class="settings-screen">
        <div class="settings-subhead">
          <button type="button" class="settings-back-btn" onclick="openSettingsScreen('home')"> Voltar</button>
          <h3 class="settings-subtitle-title">Backup</h3>
        </div>
        <section class="settings-block">
          <p class="settings-label">Backup local</p>
          <div class="settings-list">
            <button type="button" class="settings-action-btn full" onclick="exportSystemBackup()">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v12m0 0l4-4m-4 4l-4-4M5 21h14"/>
              </svg>
              Exportar backup completo
            </button>
            <button type="button" class="settings-action-btn full" onclick="importSystemBackup()">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 21V9m0 0l4 4m-4-4l-4 4M5 3h14"/>
              </svg>
              Importar backup
            </button>
            <button type="button" class="settings-action-btn full" onclick="openSystemResetModal()">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6h18"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 6V4h8v2"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 6l-1 14H6L5 6"></path>
              </svg>
              Resetar sistema
            </button>
          </div>
        </section>
      </div>

      <div id="settings-screen-import" class="settings-screen">
        <div class="settings-subhead">
          <button type="button" class="settings-back-btn" onclick="openSettingsScreen('home')"> Voltar</button>
          <h3 class="settings-subtitle-title">ImportaÃ§Ã£o</h3>
        </div>
        <section class="settings-block">
          <p class="settings-label">ImportaÃ§Ã£o em lote</p>
          <div class="settings-list">
            <button type="button" class="settings-action-btn full" onclick="triggerBatchImport('vehicle')">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6h11v9H3z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4l3 3v2h-7z"/>
              </svg>
              Importar veÃ­culos por planilha
            </button>
          </div>
        </section>
        <section class="settings-block">
          <p class="settings-label">Modelos de planilha</p>
          <div class="settings-list">
            <button type="button" class="settings-action-btn full" onclick="downloadBatchTemplate('vehicle')">Baixar modelo de veÃ­culos</button>
          </div>
        </section>
      </div>

      <div id="settings-screen-about" class="settings-screen">
        <div class="settings-subhead">
          <button type="button" class="settings-back-btn" onclick="openSettingsScreen('home')"> Voltar</button>
          <h3 class="settings-subtitle-title">Sobre os dados</h3>
        </div>
        <section class="settings-block">
          <p class="settings-label">Armazenamento</p>
          <p class="settings-description">Todos os cadastros do WeFrotas ficam salvos no <code>localStorage</code> do navegador. Use exportaÃ§Ã£o e importaÃ§Ã£o para manter backups seguros. A importaÃ§Ã£o em lote estÃ¡ ativa apenas para veÃ­culos; motoristas e fornecedores seguem com cadastro manual.</p>
        </section>
      </div>
    </div>
  </aside>

  <div id="notifications-overlay" class="panel-overlay" onclick="toggleNotifications(false)"></div>
  <aside id="notifications-panel" class="panel-shell" aria-hidden="true">
    <div class="panel-head">
      <div>
        <p class="panel-kicker">WeFrotas</p>
        <h2 class="panel-title">NotificaÃ§Ãµes</h2>
      </div>
      <button class="icon-action bg-white border border-slate-200 text-slate-600" type="button" onclick="toggleNotifications(false)" aria-label="Fechar notificaÃ§Ãµes">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 6l12 12M18 6L6 18"/>
        </svg>
      </button>
    </div>
    <div class="panel-body space-y-4">
      <div class="flex items-center justify-between gap-3">
        <p class="settings-label !mb-0">HistÃ³rico recente</p>
        <button type="button" class="settings-action-btn !h-11 !px-4" onclick="clearAllNotifications()">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7h16M9 7V5h6v2M8 7l1 12h6l1-12"/>
          </svg>
          Limpar
        </button>
      </div>
      <div id="notifications-list" class="notifications-list"></div>
    </div>
  </aside>

  <div id="prompt-modal-backdrop" class="prompt-modal-backdrop hidden" onclick="handlePromptBackdrop(event)">
    <div class="prompt-modal-card">
      <div class="prompt-modal-head">
        <div class="prompt-modal-title-wrap">
          <div id="prompt-modal-icon" class="prompt-modal-icon" aria-hidden="true">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v4m0 4h.01M4.93 19h14.14c1.54 0 2.5-1.67 1.73-3L13.73 4c-.77-1.33-2.69-1.33-3.46 0L3.2 16c-.77 1.33.19 3 1.73 3z"/>
            </svg>
          </div>
          <p class="panel-kicker">WeFrotas</p>
          <h3 id="prompt-modal-title" class="prompt-modal-title">Justificativa</h3>
        </div>
        <button type="button" class="icon-action bg-white border border-slate-200 text-slate-600" onclick="closePromptModal()" aria-label="Fechar justificativa">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 6l12 12M18 6L6 18"/>
          </svg>
        </button>
      </div>
      <div class="prompt-modal-body">
        <p id="prompt-modal-text" class="settings-description">Explique o motivo para continuar.</p>
        <label id="prompt-modal-input-label" class="settings-input-label" for="prompt-modal-input">Justificativa</label>
        <textarea id="prompt-modal-input" class="prompt-modal-textarea" placeholder="Descreva aqui o motivo"></textarea>
      </div>
      <div class="prompt-modal-actions">
        <button id="prompt-modal-cancel-btn" type="button" class="settings-action-btn" onclick="closePromptModal()">Cancelar</button>
        <button id="prompt-modal-confirm-btn" type="button" class="settings-action-btn active" onclick="confirmPromptModal()">Confirmar</button>
      </div>
    </div>
  </div>

  <div id="settings-feedback-backdrop" class="prompt-modal-backdrop hidden">
    <div class="prompt-modal-card settings-feedback-card">
      <div class="prompt-modal-body">
        <div id="settings-feedback-icon" class="batch-feedback-icon loading">
          <span class="batch-feedback-spinner"></span>
        </div>
        <p id="settings-feedback-kicker" class="panel-kicker text-center">WeFrotas</p>
        <h3 id="settings-feedback-title" class="prompt-modal-title text-center">Salvando personalizaÃ§Ã£o</h3>
        <p id="settings-feedback-text" class="settings-description text-center">Aguarde enquanto aplicamos a sua logo personalizada.</p>
      </div>
      <div class="prompt-modal-actions justify-center">
        <button id="settings-feedback-close" type="button" class="settings-action-btn active hidden" onclick="closeSettingsFeedback()">Fechar</button>
      </div>
    </div>
  </div>

  <div id="modal-backdrop" class="modal-backdrop" onclick="handleModalBackdrop(event)">
    <div class="modal-card">
      <div class="modal-header">
        <div>
          <p id="modal-kicker" class="text-xs font-extrabold uppercase tracking-[0.2em] text-[#6670e6]">Cadastro</p>
          <h3 id="modal-title" class="text-2xl font-extrabold text-slate-900 mt-2">Novo cadastro</h3>
        </div>
        <button class="icon-action bg-white border border-slate-200 text-slate-600" onclick="closeCadastroModal()">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 6l12 12M18 6L6 18"/>
          </svg>
        </button>
      </div>
      <div class="modal-body">
        <form id="cadastro-form" class="space-y-6">
          <div id="modal-fields" class="form-grid"></div>
          <div id="modal-actions" class="flex items-center justify-end gap-3 pt-2">
            <button type="button" class="soft-btn" onclick="closeCadastroModal()">Cancelar</button>
            <button id="modal-submit-btn" type="submit" class="soft-btn primary">Salvar cadastro</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div id="batch-feedback-backdrop" class="batch-feedback-backdrop hidden">
    <div class="batch-feedback-card">
      <div id="batch-feedback-icon" class="batch-feedback-icon loading">
        <span class="batch-feedback-spinner"></span>
      </div>
      <p id="batch-feedback-kicker" class="batch-feedback-kicker">ImportaÃ§Ã£o em andamento</p>
      <h3 id="batch-feedback-title" class="batch-feedback-title">Processando planilha...</h3>
      <p id="batch-feedback-text" class="batch-feedback-text">Estamos validando os registros e organizando os dados para entrada no WeFrotas.</p>
      <div id="batch-feedback-meta" class="batch-feedback-meta hidden"></div>
      <button id="batch-feedback-close" type="button" class="soft-btn primary hidden" onclick="closeBatchFeedback()">Fechar</button>
    </div>
  </div>

  <input id="wefrotas-import-backup-input" type="file" accept=".json" class="hidden" onchange="handleBackupImportFile(event)">
  <input id="wefrotas-batch-import-input" type="file" accept=".xlsx,.xls,.csv" class="hidden" onchange="handleBatchImportFile(event)">

  <script src="./wefrotas.js?v=20260406-1"></script>
</body>
</html>
