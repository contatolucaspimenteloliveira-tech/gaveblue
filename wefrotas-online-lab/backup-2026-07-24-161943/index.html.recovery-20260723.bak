              <div>
                <label class="block text-[13px] font-bold uppercase tracking-wide text-slate-600 mb-3">VeÃ­culo</label>
                <select id="report-filter-vehicle" class="soft-input w-full">
                  <option value="">Todos os veÃ­culos</option>
                </select>
              </div>
              <div>
                <label class="block text-[13px] font-bold uppercase tracking-wide text-slate-600 mb-3">Perodo inicial</label>
