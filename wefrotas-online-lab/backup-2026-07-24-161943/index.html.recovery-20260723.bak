        <section id="panel-orders" class="module-panel content-card p-8 sm:p-10">
          <h2 class="text-[2rem] font-extrabold text-slate-900 mb-10">OS</h2>

          <div class="filter-card p-6 sm:p-7 mb-10">
            <div class="grid xl:grid-cols-[1.3fr_1fr_1fr_1fr_1fr_1fr_auto_auto] gap-4 items-end">
              <div>
                <label class="block text-[13px] font-bold uppercase tracking-wide text-slate-600 mb-3">Pesquisa rápida</label>
                <input id="order-filter-search" class="soft-input w-full" placeholder="Buscar OS, veículo, responsável ou descrição">
              </div>
              <div>
                <label class="block text-[13px] font-bold uppercase tracking-wide text-slate-600 mb-3">Nº da OS</label>
                <input id="order-filter-number" class="soft-input w-full" placeholder="Ex: 0001">
              </div>
              <div>
                <label class="block text-[13px] font-bold uppercase tracking-wide text-slate-600 mb-3">Data Inicial</label>
                <input id="order-filter-start" type="date" class="soft-input w-full">
              </div>
              <div>
                <label class="block text-[13px] font-bold uppercase tracking-wide text-slate-600 mb-3">Data Final</label>
                <input id="order-filter-end" type="date" class="soft-input w-full">
              </div>
              <div>
                <label class="block text-[13px] font-bold uppercase tracking-wide text-slate-600 mb-3">Status</label>
                <select id="order-filter-status" class="soft-input w-full">
                  <option value="">Todos os status</option>
                  <option value="aberta">Aberta</option>
                  <option value="andamento">Em andamento</option>
                  <option value="fechada">Fechada</option>
                </select>
              </div>
              <div>
                <label class="block text-[13px] font-bold uppercase tracking-wide text-slate-600 mb-3">Ordenação</label>
                <select id="order-filter-sort" class="soft-input w-full">
                  <option value="recentes">Mais recentes</option>
                  <option value="antigas">Mais antigas</option>
                </select>
              </div>
              <button class="icon-action primary" title="Aplicar filtros" onclick="renderOrders()">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M4 5h16l-6 7v6l-4-2v-4L4 5z"/>
                </svg>
              </button>
              <button class="icon-action bg-white border border-slate-200 text-slate-600" title="Limpar filtros" onclick="clearOrderFilters()">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M6 6l12 12M18 6L6 18"/>
                </svg>
              </button>
            </div>
          </div>

          <div class="entity-list-shell">
            <div class="entity-toolbar-sticky mb-6">
              <div class="flex items-center justify-between gap-4 flex-wrap entity-toolbar-panel">
                <div class="flex items-center gap-4">
                  <button id="select-all-orders" class="selection-check" onclick="toggleSelectAllOrders(event)">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 12l4 4 10-10"/>
                    </svg>
                  </button>
                  <span id="orders-selected-text" class="text-[1.05rem] font-semibold text-slate-700">0 selecionadas</span>
                </div>

                <div class="module-action-toolbar">
                  <button class="icon-action text-[#8b3dff]" title="Nova OS" onclick="openCadastroModal('order')">
                    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M12 5v14M5 12h14"/>
                    </svg>
                  </button>
                  <button id="edit-order-btn" class="icon-action text-[#81a4ff]" title="Editar" onclick="editSelectedOrder()">
                    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M16.5 4.5l3 3L9 18l-4 1 1-4 10.5-10.5z"/>
                    </svg>
                  </button>
                  <button id="print-order-btn" class="icon-action text-[#bd8dff]" title="Imprimir" onclick="printSelectedOrder()">
                    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M7 8V4h10v4M7 16H5a2 2 0 01-2-2v-3a2 2 0 012-2h14a2 2 0 012 2v3a2 2 0 01-2 2h-2M7 12h10v8H7z"/>
                    </svg>
                  </button>
                  <button id="close-order-btn" class="icon-action text-[#71d08b]" title="Fechar OS" onclick="closeSelectedOrder()">
                    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M5 12l5 5L19 8"/>
                    </svg>
                  </button>
                  <button id="reopen-order-btn" class="icon-action text-[#f59e0b]" title="Reabrir OS" onclick="reopenSelectedOrder()">
                    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M20 11a8 8 0 1 1-2.34-5.66"/>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M20 4v5h-5"/>
                    </svg>
                  </button>
                  <button id="delete-order-btn" class="icon-action text-[#f28787]" title="Excluir" onclick="deleteSelectedOrders()">
                    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M4 7h16M9 7V5h6v2M8 7l1 12h6l1-12"/>
                    </svg>
                  </button>
                </div>
              </div>
            </div>

            <div id="orders-list-shell" class="entity-list-scroll">
              <div id="orders-list" class="space-y-4">
                <div class="empty-state">Nenhuma ordem de serviço cadastrada.</div>
              </div>
            </div>
          </div>
        </section>
        </section>

        <section id="panel-home" class="module-panel active content-card p-8 sm:p-10">
          <h2 class="text-[2rem] font-extrabold text-slate-900 mb-6">Home</h2>
          <div class="grid md:grid-cols-3 xl:grid-cols-6 gap-5">
            <div class="filter-card p-6">
              <p class="text-slate-500 text-sm font-semibold mb-2">VeÃ­culos</p>
              <p id="home-total-vehicles" class="text-4xl font-extrabold text-[#6267d9]">0</p>
            </div>
            <div class="filter-card p-6">
              <p class="text-slate-500 text-sm font-semibold mb-2">Motoristas</p>
              <p id="home-total-drivers" class="text-4xl font-extrabold text-[#6267d9]">0</p>
            </div>
            <div class="filter-card p-6">
              <p class="text-slate-500 text-sm font-semibold mb-2">Contas</p>
              <p id="home-total-finance" class="text-4xl font-extrabold text-[#6267d9]">0</p>
            </div>
            <div class="filter-card p-6">
              <p class="text-slate-500 text-sm font-semibold mb-2">Melhor custo/KM</p>
              <p id="home-cost-per-km" class="text-2xl font-extrabold text-[#6267d9]">R$ 0,00</p>
              <p id="home-cost-per-km-label" class="text-xs text-slate-500 mt-2">Nenhum abastecimento registrado</p>
            </div>
            <div class="filter-card p-6">
              <p class="text-slate-500 text-sm font-semibold mb-2">CNHs a vencer</p>
              <p id="home-cnh-expiring" class="text-4xl font-extrabold text-[#6267d9]">0</p>
            </div>
            <div class="filter-card p-6">
              <p class="text-slate-500 text-sm font-semibold mb-2">Seguros a vencer</p>
              <p id="home-insurance-expiring" class="text-4xl font-extrabold text-[#6267d9]">0</p>
            </div>
          </div>
          <div class="grid xl:grid-cols-3 gap-5 mt-6">
            <div class="filter-card p-6 xl:col-span-1">
              <h3 class="text-lg font-extrabold text-slate-900 mb-4">Custo por KM por veÃ­culo</h3>
              <div id="home-cost-table" class="space-y-3 text-sm text-slate-600"></div>
            </div>
            <div class="filter-card p-6 xl:col-span-1">
              <h3 class="text-lg font-extrabold text-slate-900 mb-4">CNHs prÃ³ximas a vencer</h3>
              <div id="home-cnh-table" class="space-y-3 text-sm text-slate-600"></div>
            </div>
            <div class="filter-card p-6 xl:col-span-1">
              <h3 class="text-lg font-extrabold text-slate-900 mb-4">Seguros prÃ³ximos a vencer</h3>
              <div id="home-insurance-table" class="space-y-3 text-sm text-slate-600"></div>
            </div>
          </div>
          <div class="filter-card p-6 mt-6">
            <div class="mb-4">
              <h3 class="text-lg font-extrabold text-slate-900">RevisÃµes por KM</h3>
            </div>
            <div id="home-maintenance-table" class="space-y-3 text-sm text-slate-600"></div>
          </div>
        </section>

        <section id="panel-veiculos" class="module-panel content-card p-8 sm:p-10">
          <h2 class="text-[2rem] font-extrabold text-slate-900 mb-10">Lista de VeÃ­culos</h2>
          <div class="flex items-center justify-between gap-4 flex-wrap mb-10">
            <div class="flex items-center gap-4">
              <button id="select-all-vehicles" class="selection-check" onclick="toggleSelectAllVehicles(event)">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 12l4 4 10-10"/>
                </svg>
              </button>
              <span id="vehicles-selected-text" class="text-[1.05rem] font-semibold text-slate-700">0 selecionados</span>
            </div>
            <div class="module-action-toolbar">
              <button class="icon-action text-[#8b3dff]" title="Novo VeÃ­culo" onclick="openCadastroModal('vehicle')">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M12 5v14M5 12h14"/></svg>
              </button>
              <button id="edit-vehicle-btn" class="icon-action text-[#81a4ff]" title="Editar VeÃ­culo" onclick="editSelectedVehicle()">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M16.5 4.5l3 3L9 18l-4 1 1-4 10.5-10.5z"/></svg>
              </button>
              <button id="delete-vehicle-btn" class="icon-action text-[#f28787]" title="Excluir VeÃ­culo" onclick="deleteSelectedVehicles()">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M4 7h16M9 7V5h6v2M8 7l1 12h6l1-12"/></svg>
              </button>
            </div>
          </div>
          <div id="vehicles-list" class="space-y-4">
            <div class="empty-state">Nenhum veÃ­culo cadastrado. Clique no botÃ£o + para comeÃ§ar.</div>
          </div>
        </section>

        <section id="panel-motoristas" class="module-panel content-card p-8 sm:p-10">
          <h2 class="text-[2rem] font-extrabold text-slate-900 mb-10">Lista de Motoristas</h2>
          <div class="flex items-center justify-between gap-4 flex-wrap mb-10">
            <div class="flex items-center gap-4">
              <button id="select-all-drivers" class="selection-check" onclick="toggleSelectAllDrivers(event)">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 12l4 4 10-10"/>
                </svg>
              </button>
              <span id="drivers-selected-text" class="text-[1.05rem] font-semibold text-slate-700">0 selecionados</span>
            </div>
            <div class="module-action-toolbar">
              <button class="icon-action text-[#8b3dff]" title="Novo Motorista" onclick="openCadastroModal('driver')">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M12 5v14M5 12h14"/></svg>
              </button>
              <button id="edit-driver-btn" class="icon-action text-[#81a4ff]" title="Editar Motorista" onclick="editSelectedDriver()">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M16.5 4.5l3 3L9 18l-4 1 1-4 10.5-10.5z"/></svg>
              </button>
              <button id="delete-driver-btn" class="icon-action text-[#f28787]" title="Excluir Motorista" onclick="deleteSelectedDrivers()">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M4 7h16M9 7V5h6v2M8 7l1 12h6l1-12"/></svg>
              </button>
            </div>
          </div>
          <div id="drivers-list" class="space-y-4">
            <div class="empty-state">Nenhum motorista cadastrado. Clique no botÃ£o + para comeÃ§ar.</div>
          </div>
        </section>

        <section id="panel-fornecedores" class="module-panel content-card p-8 sm:p-10">
          <h2 class="text-[2rem] font-extrabold text-slate-900 mb-10">Lista de Fornecedores</h2>
          <div class="flex items-center justify-between gap-4 flex-wrap mb-10">
            <div class="flex items-center gap-4">
              <button id="select-all-suppliers" class="selection-check" onclick="toggleSelectAllSuppliers(event)">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 12l4 4 10-10"/>
