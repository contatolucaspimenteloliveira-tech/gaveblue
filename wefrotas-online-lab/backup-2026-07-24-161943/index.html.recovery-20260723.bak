                <div class="flex items-center gap-4">
                  <button id="select-all-finance" class="selection-check" onclick="toggleSelectAllFinance(event)">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 12l4 4 10-10"/>
                    </svg>
                  </button>
                  <span id="finance-selected-text" class="text-[1.05rem] font-semibold text-slate-700">0 selecionados</span>
                </div>
                <div class="module-action-toolbar">
                  <button class="icon-action text-[#8b3dff]" title="Novo lançamento" onclick="openCadastroModal('finance')">
                    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M12 5v14M5 12h14"/></svg>
                  </button>
                  <button id="group-finance-btn" class="icon-action text-[#5f6ef5]" title="Agrupar abastecimentos" onclick="openFuelGroupingModal()">
                    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M8 7h8M8 12h8M8 17h8"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M18 12l2 2 4-4"/></svg>
                  </button>
                  <button id="ungroup-finance-btn" class="icon-action text-[#f59e0b]" title="Desfazer agrupamento" onclick="undoSelectedFuelGrouping()">
                    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M4 7h10M4 12h6M4 17h10"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M20 8l-4 4 4 4"/></svg>
                  </button>
                  <button id="view-finance-btn" class="icon-action text-[#d39a2f]" title="Visualizar" onclick="viewSelectedFinance()">
                    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M1.5 12s4-7 10.5-7 10.5 7 10.5 7-4 7-10.5 7S1.5 12 1.5 12z"/><circle cx="12" cy="12" r="3" stroke-width="1.9"/></svg>
                  </button>
                  <button id="close-finance-expense-btn" class="icon-action text-[#3455a6]" title="Fechar despesa" onclick="openCloseFuelExpenseModal()">
                    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M7 11V8a5 5 0 0110 0v3"/><rect x="5" y="11" width="14" height="10" rx="2" ry="2" stroke-width="1.9"/></svg>
                  </button>
                  <button id="edit-finance-btn" class="icon-action text-[#81a4ff]" title="Editar lançamento" onclick="editSelectedFinance()">
                    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M16.5 4.5l3 3L9 18l-4 1 1-4 10.5-10.5z"/></svg>
                  </button>
                  <button id="delete-finance-btn" class="icon-action text-[#f28787]" title="Excluir lançamento" onclick="deleteSelectedFinance()">
                    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M4 7h16M9 7V5h6v2M8 7l1 12h6l1-12"/></svg>
                  </button>
                </div>
              </div>
            </div>
            <div id="finance-list-shell" class="entity-list-scroll">
              <div id="finance-list" class="space-y-4">
                <div class="empty-state">Nenhum lançamento financeiro cadastrado.</div>
              </div>
            </div>
          </div>
        </section>

        <section id="panel-relatorios" class="module-panel content-card p-8 sm:p-10">
          <h2 class="text-[2rem] font-extrabold text-slate-900 mb-10">RelatÃ³rios</h2>
          <div class="filter-card p-6 sm:p-7 mb-8">
            <div class="grid xl:grid-cols-[1fr_1fr_1fr_1fr_auto_auto] gap-4 items-end">
              <div>
                <label class="block text-[13px] font-bold uppercase tracking-wide text-slate-600 mb-3">Tipo de relatÃ³rio</label>
                <select id="report-filter-type" class="soft-input w-full">
                  <option value="cost">Custo por KM</option>
