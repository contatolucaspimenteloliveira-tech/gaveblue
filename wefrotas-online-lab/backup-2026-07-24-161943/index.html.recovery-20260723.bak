              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M14 10h4l3 3v2h-7z"/>
              <circle cx="7" cy="18" r="2"></circle>
              <circle cx="18" cy="18" r="2"></circle>
            </svg>
            <span class="nav-tooltip">VeÃ­culos</span>
          </button>

          <button class="nav-btn" onclick="showModule('motoristas', this)">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <circle cx="12" cy="8" r="3.2" stroke-width="1.9"></circle>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M5 20c0-3.314 3.134-6 7-6s7 2.686 7 6"/>
            </svg>
            <span class="nav-tooltip">Motoristas</span>
