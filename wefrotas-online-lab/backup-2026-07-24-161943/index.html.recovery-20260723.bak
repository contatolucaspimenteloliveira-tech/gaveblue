              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M4 10h16v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M8 14h.01M12 14h.01M16 14h.01M8 17h.01M12 17h.01M16 17h.01"></path>
            </svg>
