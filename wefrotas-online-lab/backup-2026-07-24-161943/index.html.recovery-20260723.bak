<body>
  <div id="search-focus-overlay" class="search-focus-overlay hidden"></div>
  <div id="mobile-search-backdrop" class="mobile-search-backdrop"></div>
  <div id="mobile-search-modal" class="mobile-search-modal">
    <div class="global-search">
      <svg class="global-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <circle cx="11" cy="11" r="7" stroke-width="2"></circle>
        <path d="M20 20L17 17" stroke-width="2" stroke-linecap="round"></path>
      </svg>
      <input id="mobile-global-search-input" type="text" class="global-search-input text-sm font-medium" placeholder="Pesquisar mdulo..." autocomplete="off" aria-label="Pesquisar mdulo">
      <div id="mobile-global-search-results" class="global-search-results hidden"></div>
    </div>
  </div>
  <div class="workspace-shell flex flex-col min-h-full">
    <header class="app-header relative z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-3">
        <div class="flex items-center gap-3 min-w-0">
          <a href="https://gaveblue.com.br/" target="_self" rel="noopener noreferrer">
            <img src="https://i.imgur.com/Zih5jH8.png" alt="Logo GaveBlue" class="h-12 w-auto cursor-pointer hover:opacity-80 transition-opacity" loading="lazy">
          </a>
          <div class="hidden md:block w-px h-6 bg-slate-700/70"></div>
          <div class="hidden md:block min-w-0">
            <p class="text-slate-400 text-xs uppercase tracking-[0.22em] font-semibold">WeFrotas</p>
            <h1 class="text-white text-sm sm:text-base font-bold truncate">Gesto de Frotas Inteligente</h1>
          </div>
        </div>
        <div class="flex items-center gap-2 sm:gap-3">
          <div class="global-search">
            <svg class="global-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <circle cx="11" cy="11" r="7" stroke-width="2"></circle>
              <path d="M20 20L17 17" stroke-width="2" stroke-linecap="round"></path>
            </svg>
            <input id="global-search-input" type="text" class="global-search-input text-sm font-medium" placeholder="Pesquisar mdulo..." autocomplete="off" aria-label="Pesquisar mdulo">
            <div id="global-search-results" class="global-search-results hidden"></div>
          </div>
          <button id="mobile-search-btn" class="mobile-search-toggle" type="button" aria-label="Pesquisar mdulo">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <circle cx="11" cy="11" r="7" stroke-width="2"></circle>
              <path d="M20 20L17 17" stroke-width="2" stroke-linecap="round"></path>
            </svg>
          </button>
          <button class="top-action header-utility-btn" type="button" onclick="toggleNotifications()" aria-label="NotificaÃ§Ãµes">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.4-1.4A2 2 0 0118 14.17V11a6 6 0 10-12 0v3.17c0 .53-.21 1.04-.59 1.43L4 17h5m6 0a3 3 0 11-6 0m6 0H9" />
            </svg>
            <span id="notifications-badge" class="notification-badge hidden">0</span>
          </button>
          <button class="top-action header-utility-btn" type="button" onclick="toggleSettings()" aria-label="Configuraes">
