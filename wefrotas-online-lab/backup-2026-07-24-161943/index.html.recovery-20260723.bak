        <section id="panel-financeiro" class="module-panel content-card p-8 sm:p-10">
          <h2 class="text-[2rem] font-extrabold text-slate-900 mb-10">Financeiro</h2>
          <div class="filter-card p-6 sm:p-7 mb-10">
            <div class="grid xl:grid-cols-[1.2fr_1.2fr_1fr_1fr_1fr_1fr_auto_auto] gap-4 items-end">
              <div>
                <label class="block text-[13px] font-bold uppercase tracking-wide text-slate-600 mb-3">Pesquisa rápida</label>
                <input id="finance-filter-search" class="soft-input w-full" placeholder="Buscar fornecedor, NF, OS, veículo ou observação">
              </div>
              <div>
                <label class="block text-[13px] font-bold uppercase tracking-wide text-slate-600 mb-3">Fornecedor</label>
                <input id="finance-filter-supplier" class="soft-input w-full" placeholder="Buscar fornecedor">
              </div>
              <div>
                <label class="block text-[13px] font-bold uppercase tracking-wide text-slate-600 mb-3">Status</label>
                <select id="finance-filter-status" class="soft-input w-full">
                  <option value="">Todos</option>
                  <option value="pendente">Pendentes</option>
                  <option value="pendente_os">Pendentes de OS</option>
                  <option value="distribuido">Finalizadas</option>
                  <option value="agrupado">Agrupadas</option>
                </select>
              </div>
              <div>
                <label class="block text-[13px] font-bold uppercase tracking-wide text-slate-600 mb-3">Veículo</label>
