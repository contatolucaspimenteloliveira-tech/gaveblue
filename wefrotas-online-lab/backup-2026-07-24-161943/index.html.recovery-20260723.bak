            </svg>
            <span class="nav-tooltip">Home</span>
          </button>

          <button class="nav-btn" onclick="showModule('orders', this)">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M7 3h7l5 5v13H7z"/>
