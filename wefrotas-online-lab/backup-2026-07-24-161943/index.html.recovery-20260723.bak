                  <option value="">Todos os veículos</option>
                </select>
              </div>
              <div>
                <label class="block text-[13px] font-bold uppercase tracking-wide text-slate-600 mb-3">Data</label>
                <input id="finance-filter-date" type="date" class="soft-input w-full">
              </div>
              <div>
                <label class="block text-[13px] font-bold uppercase tracking-wide text-slate-600 mb-3">Valor</label>
                <input id="finance-filter-value" class="soft-input w-full" placeholder="Ex: 1500,00">
              </div>
              <button class="icon-action primary" title="Aplicar filtros" onclick="renderFinance()">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
